# Copie este arquivo para .env.local e ajuste os dados do seu projeto Supabase.
#
# Sem DATABASE_URL, a API grava em .data/db.json (modo desenvolvimento, sem banco).
# Com DATABASE_URL preenchida, a API passa a usar o PostgreSQL automaticamente.
#
# Pegue a string em: painel do Supabase → Project Settings → Database →
# Connection string → Transaction pooler (porta 6543; funciona melhor em
# hospedagem serverless, como a Netlify, do que a conexão direta).
# Formato: postgresql://usuario:senha@host:porta/postgres
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# O Supabase sempre exige conexão criptografada (TLS). Na Netlify, cadastre
# DATABASE_URL e DATABASE_SSL=true nas variáveis de ambiente do site.
DATABASE_SSL="true"
